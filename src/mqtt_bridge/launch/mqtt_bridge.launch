<launch>
  <!-- MQTT桥接节点 -->
  <node name="mqtt_bridge_node" pkg="mqtt_bridge" type="mqtt_bridge_node" output="screen">
    <!-- MQTT服务器配置 -->
    <param name="server_address" value="mqtts://de80ed56.ala.cn-hangzhou.emqxsl.cn" />
    <param name="client_id" value="ros_uav_client" />
    <param name="username" value="px_uav" />
    <param name="password" value="123456" />
    <param name="qos" value="1" />
    <!-- MQTT连接类型 -->
    <param name="mqtt_type" value="mqtts" />
    <!-- MQTT端口 -->
    <param name="port" value="8883" />
    <!-- MQTT连接超时时间 -->
    <param name="connect_timeout" value="5.0" />
    <!-- MQTT重连间隔 -->
    <param name="reconnect_interval" value="2.0" />
    <!-- MQTT心跳间隔 -->
    <param name="keep_alive_interval" value="60.0" />
    <!-- MQTT消息队列大小 -->
    <param name="queue_size" value="10" />
    <!-- MQTT TLS配置 -->
    <param name="tls_enabled" value="true" />
    <param name="tls_version" value="TLSv1.2" />
    <param name="tls_ciphers" value="ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384" />
    <param name="tls_insecure" value="true" />
    
    <!-- CA证书路径，需要根据实际情况修改 -->
    <param name="ca_cert_path" value="$(find mqtt_bridge)/config/emqxsl-ca.crt" />
    <!-- UAV配置 -->
    <param name="uav_name" value="/uav1" />
    <param name="uav_state_mqtt_topic" value="uav1/flight_controller/state" />
  </node>
</launch>

<!-- 订阅和发布配置 -->
