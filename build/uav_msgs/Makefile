	cd /home/px4/UAV_SDK/build && $(MAKE) -f CMakeFiles/Makefile2 uav_msgs/CMakeFiles/uav_msgs_generate_messages.dir/rule
.PHONY : uav_msgs/CMakeFiles/uav_msgs_generate_messages.dir/rule

